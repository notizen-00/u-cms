# Docker Compose overrides. Copy to `.env` only if the defaults don't suit you —
# docker-compose.yml carries a working default for every value here, so an
# untouched checkout runs with `docker compose up -d` and no .env at all.
#
# This file configures the CONTAINER stack only. Running the apps natively?
# Those read apps/backend/.env and apps/dashboard/.env instead.

# --- Host ports -------------------------------------------------------------
# Change any that collide with something already running on your machine.
POSTGRES_PORT=5432
# 6380 by default because a native Windows redis-server.exe often holds 6379.
REDIS_PORT=6380
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=3000
# Public static sites (nginx) and the admin dashboard (nginx, separate port).
PUBLIC_SITE_PORT=8080
ADMIN_PORT=8081

# --- Credentials ------------------------------------------------------------
# Change these before exposing the stack to anything but your own machine.
POSTGRES_USER=unej_cms
POSTGRES_PASSWORD=unej_cms
POSTGRES_DB=unej_cms
MINIO_ROOT_USER=unej_cms
MINIO_ROOT_PASSWORD=unej_cms_secret
MINIO_BUCKET=unej-cms-media

# --- Public URLs ------------------------------------------------------------
# Must match how a browser actually reaches each service. ADMIN_ORIGIN is
# enforced by SvelteKit's adapter-node on every form submission, so a mismatch
# shows up as forms failing rather than as a page that won't load.
ADMIN_ORIGIN=http://localhost:8081
PUBLIC_SITE_HOST=localhost:8080
# Baked into published pages (media <img> sources, form action URLs), so these
# are resolved by a visitor's browser — never by a container. Keep them
# pointing at host-reachable addresses, not compose service names.
MINIO_PUBLIC_URL=http://localhost:9000
API_PUBLIC_URL=http://localhost:3000

# --- Sessions ---------------------------------------------------------------
SESSION_COOKIE_NAME=unej_cms_session
SESSION_TTL_HOURS=168

# Optional shared secret required by POST /setup/init (header X-Setup-Token),
# which narrows the window where anyone could claim the first super-admin
# account. Leave empty when the instance isn't reachable before setup.
SETUP_TOKEN=
