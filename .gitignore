# Generated by `pnpm setup` from the matching .env.example, and holding real
# credentials once anyone edits them (or once a portable runtime install
# writes its generated ones in). The examples are the tracked copies.
.env
.env.*
!.env.example

# Portable runtime (native `pnpm setup --infra=portable|auto`). `.runtime/`
# is downloaded software — safe to delete, `pnpm runtime:repair` recreates it.
# `.data/` is what the user actually made (Postgres cluster, Redis RDB, MinIO
# objects, plus a static site build output dir) — never delete this one
# except via the explicit, confirmation-gated `pnpm runtime:reset`.
.runtime/
.data/
