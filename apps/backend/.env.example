# App
NODE_ENV=development
PORT=3000

# Postgres
DATABASE_URL=postgres://unej_cms:unej_cms@localhost:5432/unej_cms

# Redis (host port 6380 - see docker-compose.yml comment: 6379 is occupied by a
# pre-existing native Windows redis-server.exe on this machine)
REDIS_URL=redis://localhost:6380

# Sessions
SESSION_COOKIE_NAME=unej_cms_session
SESSION_TTL_HOURS=168

# Seed (super admin bootstrap, used by `pnpm db:seed` — CLI alternative to the
# admin app's setup wizard, POST /setup/init)

# Optional shared secret required by POST /setup/init (header X-Setup-Token)
# to reduce the "installer race" window. Leave unset to allow the wizard to
# run without a token (only safe if the instance isn't reachable publicly
# before setup completes).
# SETUP_TOKEN=

# MinIO (media library storage). The backend connects to it unconditionally
# at boot (MediaStorageService.onModuleInit), so it's started by default in
# deploy/docker-compose.yml, not gated behind a profile. For local dev without
# Docker, start just MinIO with `docker compose up -d minio` from deploy/.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=unej_cms
MINIO_SECRET_KEY=unej_cms_secret
MINIO_BUCKET=unej-cms-media
MINIO_USE_SSL=false
# Browser-facing base URL for public media links. Leave unset in local dev to
# fall back to http://{MINIO_ENDPOINT}:{MINIO_PORT}.
# MINIO_PUBLIC_URL=

# Static builder output (bind-mounted in dev, named volume in Docker)
BUILD_OUTPUT_DIR=./data/sites

# AI content assist (OpenAI-compatible chat completions) — powers the "Buat
# dengan AI" action in the post/page block editor. Defaults to the campus
# gateway; the feature stays disabled (503 from POST /sites/:siteId/ai/generate)
# until AI_API_TOKEN is set. AI_API_MODEL must be one of the ids chat.unej.id
# serves (GET {AI_API_BASE_URL}/models with your token lists them, e.g.
# `qwen3.6:latest`, `gemma4:31b`) — note the colon, not a hyphen, before the tag.
AI_API_BASE_URL=https://chat.unej.id/api
# AI_API_TOKEN=
AI_API_MODEL=qwen3.6:latest
