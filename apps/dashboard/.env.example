# NestJS backend base URL (see docs/PRD.md §14 in the unej-cms repo).
# Read at runtime (not build time) so the same Docker image can target different backends.
PUBLIC_API_URL=http://localhost:3000

# Host:port the public static site nginx listens on (deploy/nginx/public.conf) —
# used to build "Visit Site" links as http://{slug}.{PUBLIC_SITE_HOST}/.
# In production, point this at the real public host/port instead.
PUBLIC_SITE_HOST=localhost:8080

# --- adapter-node runtime (native `pnpm start` only) -------------------------
# Ignored by `vite dev`, which uses its own dev server on 5173.

# 3000 would collide with the API, so the built dashboard listens here.
PORT=5173

# SvelteKit checks this against the Origin header of every form submission.
# A mismatch shows up as saves failing, not as a page that won't load — keep it
# equal to the URL you actually open the dashboard at (including the port).
ORIGIN=http://localhost:5173

# Form bodies are read by adapter-node before reaching the API. Covers Page
# Builder content plus the backend's 10 MB media upload ceiling.
BODY_SIZE_LIMIT=16M
