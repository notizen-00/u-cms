{
  "name": "@unej-cms/theme-default",
  "version": "1.0.0",
  "description": "Official default UNEJ CMS theme: minimal layout for homepage, news, and static pages.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@unej-cms/sdk-core": "workspace:*",
    "@unej-cms/sdk-theme": "workspace:*",
    "@unej-cms/sdk-ui": "workspace:*"
  },
  "devDependencies": {
    "eta": "^4.6.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
